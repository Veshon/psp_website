rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      // Customers can submit an order, but cannot read or alter stored orders.
      allow create: if request.resource.data.keys().hasOnly([
          'tableNumber', 'items', 'total', 'status', 'createdAt'
        ])
        && request.resource.data.tableNumber is string
        && request.resource.data.tableNumber.size() > 0
        && request.resource.data.tableNumber.size() <= 20
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      // Only signed-in staff accounts (created by the project owner) can see or update orders.
      allow read, update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
